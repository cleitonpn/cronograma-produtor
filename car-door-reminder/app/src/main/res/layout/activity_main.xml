<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/fundo"
    android:padding="28dp">

    <!-- Ícone -->
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/ic_car_lock"
        android:contentDescription="@string/desc_icone_status" />

    <!-- Nome do app -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/app_name"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/texto_primario" />

    <!-- Carro selecionado -->
    <TextView
        android:id="@+id/tvCarroSelecionado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nenhum carro selecionado"
        android:textSize="14sp"
        android:textColor="@color/cor_primaria" />

    <!-- Status / instrução -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@color/fundo_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Selecione o dispositivo Bluetooth do seu carro para ativar o monitoramento."
            android:textSize="14sp"
            android:textColor="@color/texto_secundario"
            android:lineSpacingMultiplier="1.5"
            android:gravity="center" />

    </androidx.cardview.widget.CardView>

    <!-- Aviso: permissão Bluetooth negada -->
    <TextView
        android:id="@+id/tvAvisoPermissao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#3DFF4444"
        android:padding="14dp"
        android:text="⚠️ Permissão Bluetooth negada — o app não consegue identificar o carro"
        android:textColor="#FF6B6B"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:visibility="gone" />

    <!-- Aviso: otimização de bateria ativa -->
    <TextView
        android:id="@+id/tvAvisoBateria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#3DFF9800"
        android:padding="14dp"
        android:text="⚠️ Toque aqui para permitir segundo plano — sem isso o app para quando fechado"
        android:textColor="#FFCC00"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4" />

    <!-- Botão principal -->
    <Button
        android:id="@+id/btnSelecionarCarro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="Selecionar carro"
        android:paddingHorizontal="40dp"
        android:paddingVertical="14dp" />

</LinearLayout>
